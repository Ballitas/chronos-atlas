# Required in production (Vercel + Neon/Supabase Postgres)
# Leave empty locally to use the built-in zero-config local PostgreSQL engine (PGlite)
DATABASE_URL=

# Required: strong random secret for signing JWT tokens (min 32 chars)
JWT_SECRET=chronos-atlas-super-secret-jwt-key-change-in-production-2026
JWT_EXPIRES_IN=24h

# App base URL (auto-detected on Vercel via VERCEL_URL if omitted)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Sentry Error Monitoring (Extra Points!)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional: Real Email Delivery for Password Recovery
# Option A: Resend API
RESEND_API_KEY=
EMAIL_FROM=Chronos Atlas <noreply@chronosatlas.edu>

# Option B: Generic SMTP (e.g., Gmail App Password, Mailtrap, Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Set to "false" in production if real SMTP/Resend is configured and you want to disable the built-in simulated inbox
NEXT_PUBLIC_ENABLE_MAIL_SANDBOX=true
